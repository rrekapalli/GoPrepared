# Runtime-only image (JAR built separately). Used when the multi-stage build
# is not available on the deploy machine; LXC runs: podman build -f Dockerfile.runtime .
FROM docker.io/library/eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN useradd --system --uid 10001 --home /app goprepared \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY go-prepared-api.jar /app/app.jar
RUN chown goprepared:goprepared /app/app.jar
USER goprepared
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -sf http://127.0.0.1:8080/api/v1/knowledge/categories >/dev/null || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
