# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goprepared
POSTGRES_USER=goprepared
POSTGRES_PASSWORD=goprepared

# Spring Boot API
API_PORT=8080
JWT_SECRET=change-me-in-production-use-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=your-microsoft-entra-app-client-id
MICROSOFT_TENANT_ID=common
GOPREPARED_AUTH_DEV_ENABLED=true

# AI Provider (Spring AI)
GOPREPARED_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# Flutter (local dev)
API_BASE_URL=http://localhost:8080/api/v1

# --- Proxmox (remote deploy from dev machine) ---
PROXMOX_HOST=192.168.29.231
PROXMOX_USER=root
PROXMOX_PASSWORD=

# --- LXC container login (goprepared VMID 7003) ---
# CONTAINER_* and SSH_* are interchangeable (same as MoneyTree / purana-samhitha).
CONTAINER_USER=raja
CONTAINER_PASSWORD=

# --- SSH (optional; direct access to LXC on tailnet) ---
# If only one pair is set, deploy scripts copy it to the other.
SSH_USER=raja
SSH_PASSWORD=

# --- Tailscale (optional; auto-join on deploy) ---
# Pre-auth key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TAILNET_DNS=tailce422e.ts.net
# Tailscale Admin API Key (tskey-api-...) for hostname dedupe on re-deploy
TAILSCALE_API_KEY=

# --- Public hostname (MagicDNS) ---
GOPREPARED_HOST=goprepared.tailce422e.ts.net

# Production Postgres/Ollama on tailnet (override for deploy)
# POSTGRES_HOST=pg18.tailce422e.ts.net
# OLLAMA_BASE_URL=http://ollama.tailce422e.ts.net

# --- Flutter (optional; if not on PATH) ---
# FLUTTER=/path/to/flutter/bin/flutter
